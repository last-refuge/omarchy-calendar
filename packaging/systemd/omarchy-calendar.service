[Unit]
Description=Omarchy Calendar local data service
Documentation=https://github.com/last-refuge/omarchy-calendar
After=graphical-session.target

[Service]
Type=dbus
BusName=org.omarchy.Calendar
EnvironmentFile=-/usr/share/omarchy-calendar/google-oauth.env
EnvironmentFile=-%h/.config/omarchy-calendar/google-oauth.env
ExecStart=/usr/bin/omarchy-calendar-service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
